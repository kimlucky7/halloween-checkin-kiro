{
  // LOCAL-ONLY configuration for `wrangler dev --local` and scripts/e2e-local.mjs.
  // The ids below are placeholders: local mode simulates D1/R2 on disk and never
  // contacts Cloudflare. This file must not be used to deploy.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "halloween-checkin-local",
  "main": "worker/halloween/index.js",
  "compatibility_date": "2026-08-31",
  // global_fetch_strictly_public: OAuth client metadata documents and ChatGPT file
  // downloads may only reach public hosts.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/media/*", "/mcp", "/mcp/*", "/authorize", "/oauth/*", "/.well-known/*"]
  },
  "vars": { "PROJECT_ID": "halloween-checkin-local" },
  "d1_databases": [
    { "binding": "DB", "database_name": "halloween-checkin-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "halloween-checkin-local-media" }]
}
